# Optional overrides (all have defaults)
PENUMBRA_PORT=4173            # server port
PENUMBRA_YEAR=2027            # default analysis year (any year inside the kernel coverage can be requested)
PENUMBRA_TIMEOUT=90           # seconds before a computation is reported as failed
PENUMBRA_OFFLINE=0            # 1 = never contact USGS / Moon Trek for imagery tiles (cached tiles only)
PENUMBRA_LOG=INFO             # backend log level
# PENUMBRA_RAW=...            # alternative location of the raw NASA/JPL files
# PENUMBRA_CACHE=...          # alternative cache directory
