# Optional overrides (all have defaults)
PENUMBRA_PORT=4173            # server port
PENUMBRA_YEAR=2027            # default analysis year (any year inside the kernel coverage can be requested)
PENUMBRA_TIMEOUT=90           # seconds before a computation is reported as failed
PENUMBRA_OFFLINE=0            # 1 = never contact USGS / Moon Trek for imagery tiles (cached tiles only)
PENUMBRA_LOG=INFO             # backend log level
# PENUMBRA_RAW=...            # alternative location of the raw NASA/JPL files
# PENUMBRA_CACHE=...          # alternative cache directory
# In-app assistant (needs the Claude API; off when PENUMBRA_OFFLINE=1). Put the real key in .env, never in git.
# ANTHROPIC_API_KEY=sk-ant-...
# PENUMBRA_ASSISTANT=1          # 0 = switch the assistant off
# PENUMBRA_ASSISTANT_MODEL=claude-opus-5-5
# PENUMBRA_ASSISTANT_EFFORT=medium   # low | medium | high
# Space assistant chat: any OpenAI-compatible provider. Put the real key in .env, never here.
# Groq (default; free tier, no credit card):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
# Alternatives (switch by changing these three lines in .env):
# Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=           (the current Flash model name from AI Studio)
# OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=           (a model whose ID ends in :free)
# Ollama (local):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=           (a model you have pulled)
